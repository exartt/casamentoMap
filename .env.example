# Copie para .env no ambiente local. Na Hostinger, defina as mesmas variáveis no hPanel.

NODE_ENV=development
PORT=3000

# Banco MySQL (no hPanel, normalmente host localhost e porta 3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mesas
DB_USER=mesas
DB_PASSWORD=mesas

# Endereço público do app, usado para montar os links de visualização
APP_URL=http://localhost:5173

# Redireciona HTTP para HTTPS (padrão: ligado em produção, desligado fora dela)
# FORCE_HTTPS=true

# Nível de log: fatal, error, warn, info, debug, trace, silent
# LOG_LEVEL=info

# Usadas só pelos testes (npm test); os valores abaixo são os do docker-compose
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_NAME=mesas_test
# TEST_DB_USER=mesas
# TEST_DB_PASSWORD=mesas
