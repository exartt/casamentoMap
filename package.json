{
  "name": "planejador-mesas-casamento",
  "version": "1.0.0",
  "private": true,
  "description": "Planejador de mesas de casamento: planta do salão, convidados e assentos",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:sql": "tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.1.1",
    "@headlessui/react": "^2.2.4",
    "@tanstack/react-virtual": "^3.13.9",
    "@types/node": "^22.15.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.4",
    "fastify": "^5.3.2",
    "konva": "^9.3.20",
    "mysql2": "^3.14.1",
    "papaparse": "^5.5.2",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "zod": "^3.25.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vitest": "^3.1.3"
  }
}
